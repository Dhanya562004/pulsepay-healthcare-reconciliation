# ==============================================================================
# PulsePay Web Frontend Environment Configuration
# Copy this file to .env.local for local development.
# IMPORTANT: These variables are server-only (no NEXT_PUBLIC_ prefix).
# The browser never sees PULSEPAY_API_KEY.
# ==============================================================================

# FastAPI Backend base URL
PULSEPAY_API_URL=http://localhost:8000

# API authentication key (configured on the FastAPI backend)
PULSEPAY_API_KEY=your_pulsepay_api_key_here
