# ==============================================================================
# PulsePay Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# Do NOT store real production secrets or credentials in this file.
# ==============================================================================

# Database Connection URL (SQLite for local dev, PostgreSQL for remote deployment)
DATABASE_URL=sqlite:///./pulsepay.db
# DATABASE_URL=postgresql://username:password@localhost:5432/pulsepay_db

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Webhook Verification Secret (placeholder for gateway webhook simulation)
WEBHOOK_SECRET=your_webhook_secret_here

# Project Metadata
PROJECT_NAME=PulsePay Healthcare Reconciliation Engine
API_V1_STR=

# Backend API URL (used by Streamlit dashboard and test scripts)
API_BASE_URL=http://localhost:8000
